{
  "name": "voice-timer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf dist",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "generate:audio": "node scripts/generate-audio.js",
    "lint": "biome check . --reporter=concise --colors=off && tsc --noEmit --pretty false",
    "lint:fix": "biome check --write . --reporter=concise --colors=off",
    "prepare": "husky",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@audio/encode-opus": "^1.3.2",
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
